{
  "name": "sat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "ai": "cd yogyata-ai && .venv/bin/uvicorn server.app:app --port 8787 --reload --reload-dir server",
