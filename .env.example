# Copy to .env.local and fill in from Supabase: Project Settings > API Keys
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: the yogyata-ai Python service (see yogyata-ai/service/README.md).
# Leave unset to run the app without readiness scores, roadmaps or matching.
VITE_AI_SERVICE_URL=http://localhost:8000
