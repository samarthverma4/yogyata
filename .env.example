# Copy to .env.local and fill in from Supabase: Project Settings > API Keys
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional, and only when the yogyata-ai bridge does NOT run on localhost:8787:
# `npm run dev` already proxies /ai there, so leave this unset for local work.
# VITE_AI_URL=https://ai.example.com
