# Example configuration. No secrets belong here, and this package never reads API keys.

# Similarity backend for text matching: "tfidf" (default, nothing to download) or "embeddings"
# (requires `pip install -e .[embeddings]`; falls back to tfidf with a status message if unavailable)
YOGYATA_SIMILARITY_BACKEND=tfidf
YOGYATA_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional path to a replacement skills taxonomy JSON (same format as src/yogyata_ai/common/data/skills_taxonomy.json)
YOGYATA_TAXONOMY_PATH=

# LLM: no provider is built in. To enable an LLM, the integrating backend passes its own client wrapped in
# yogyata_ai.common.llm.CallableLLM to the functions that accept `llm=`. Leave "mock" or blank for deterministic mode.
YOGYATA_LLM_PROVIDER=
